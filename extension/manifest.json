{
  "manifest_version": 3,
  "name": "VocabFlash – Thêm từ vựng",
  "description": "Bôi đen từ hoặc cả đoạn trên trang web → chuột phải → Thêm vào VocabFlash / Dịch đoạn này. Từ về Hộp thư từ kèm nghĩa AI.",
  "version": "1.1.1",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VocabFlash",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ]
}
